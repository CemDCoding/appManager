{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "node_modules/.tmp/tsc-web",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@core/*": ["./src/core/*"]
    }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/core/**/*"]
}
