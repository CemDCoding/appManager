      "input": { "$value": "{color.neutral.500}" }
    },
    "action": {
      "bg": { "$value": "{color.brand.600}" },
      "bg-hover": { "$value": "{color.brand.700}" },
      "fg": { "$value": "{color.neutral.0}" },
      "secondary-bg": { "$value": "{color.neutral.100}" },
      "secondary-bg-hover": { "$value": "{color.neutral.150}" },
      "secondary-fg": { "$value": "{color.neutral.975}" },
      "danger-bg": { "$value": "{color.red.600}" },
      "danger-bg-hover": { "$value": "{color.red.700}" },
      "danger-fg": { "$value": "{color.neutral.0}" }
    },
    "focus": {
      "ring": { "$value": "{color.brand.600}" }
    },
    "value": {
      "positive": { "$value": "{color.green.600}" },
      "negative": { "$value": "{color.red.600}" },
      "positive-bg": { "$value": "{color.green.600}" },
      "negative-bg": { "$value": "{color.red.600}" },
      "pill-fg": { "$value": "{color.neutral.0}" },
      "progress": { "$value": "{color.neutral.975}" },
      "progress-track": { "$value": "{color.neutral.150}" }
    },
    "status": {
      "success-fg": { "$value": "{color.green.600}" },
      "success-bg": { "$value": "{color.green.50}" },
      "warning-fg": { "$value": "{color.amber.700}" },
      "warning-bg": { "$value": "{color.amber.50}" },
      "warning-line": { "$value": "{color.amber.600}" },
      "danger-fg": { "$value": "{color.red.600}" },
      "danger-bg": { "$value": "{color.red.50}" },
      "info-fg": { "$value": "{color.brand.700}" },
      "info-bg": { "$value": "{color.brand.50}" }
    },
    "chart": {
      "primary": { "$value": "{color.brand.600}" },
      "positive": { "$value": "{color.green.600}" },
      "negative": { "$value": "{color.red.600}" },
      "secondary": { "$value": "{color.neutral.700}" },
      "tertiary": { "$value": "{color.brand.300}" },
      "grid": { "$value": "{color.neutral.150}" },
      "axis": { "$value": "{color.neutral.650}" }
