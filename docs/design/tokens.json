      "950": { "$value": "#2a1f0c" }
    },

    "text": {
      "default": { "$value": "{color.neutral.975}" },
      "secondary": { "$value": "{color.neutral.800}" },
      "muted": { "$value": "{color.neutral.650}" },
      "inverse": { "$value": "{color.neutral.0}" },
      "link": { "$value": "{color.brand.600}" },
      "link-hover": { "$value": "{color.brand.700}" },
      "disabled": { "$value": "{color.neutral.500}" }
    },
    "surface": {
      "default": { "$value": "{color.neutral.25}" },
      "sidebar": { "$value": "{color.neutral.50}" },
      "raised": { "$value": "{color.neutral.0}" },
