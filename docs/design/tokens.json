  "font": {
    "family": {
      "sans": { "$value": ["Inter", "Segoe UI Variable Text", "Segoe UI", "system-ui", "sans-serif"] }
    },
    "size": {
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.8125rem" },
      "base": { "$value": "0.875rem" },
      "md": { "$value": "0.9375rem" },
      "lg": { "$value": "1.0625rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "2.125rem" },
      "display": { "$value": "4rem" }
    },
    "weight": {
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold": { "$value": "700" }
    },
    "tracking": {
      "normal": { "$value": "0" },
      "tight": { "$value": "-0.02em" },
      "display": { "$value": "-0.045em" },
      "label": { "$value": "0.01em" }
    },
    "leading": {
      "none": { "$value": "1" },
      "tight": { "$value": "1.2" },
      "normal": { "$value": "1.45" }
    }
  },

  "space": {
    "0": { "$value": "0" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" }
  },

  "radius": {
    "sm": { "$value": "4px" },
    "md": { "$value": "6px" },
    "lg": { "$value": "10px" },
    "full": { "$value": "9999px" }
  },

  "shadow": {
    "control": { "$value": "0 1px 2px rgb(17 19 22 / 0.10)" },
    "popover": { "$value": "0 0 0 1px rgb(17 19 22 / 0.06), 0 8px 24px rgb(17 19 22 / 0.12)" },
    "dialog": { "$value": "0 0 0 1px rgb(17 19 22 / 0.06), 0 24px 64px rgb(17 19 22 / 0.22)" }
  },

  "motion": {
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "180ms" },
      "slow": { "$value": "280ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },

  "layout": {
    "sidebar-width": { "$value": "13.125rem" },
    "content-max": { "$value": "74rem" },
    "control-height": { "$value": "2rem" },
    "control-height-sm": { "$value": "1.625rem" },
    "row-height": { "$value": "2.75rem" }
  },

  "$themes": {
    "dark": {
      "color": {
        "text": {
          "default": { "$value": "{color.neutral.100}" },
          "secondary": { "$value": "{color.neutral.300}" },
          "muted": { "$value": "{color.neutral.400}" },
          "inverse": { "$value": "{color.neutral.975}" },
          "link": { "$value": "{color.brand.400}" },
          "link-hover": { "$value": "{color.brand.300}" },
          "disabled": { "$value": "{color.neutral.600}" }
        },
        "surface": {
          "default": { "$value": "{color.neutral.1000}" },
          "sidebar": { "$value": "{color.neutral.975}" },
          "raised": { "$value": "{color.neutral.950}" },
          "sunken": { "$value": "{color.neutral.975}" },
          "hover": { "$value": "{color.neutral.925}" },
          "selected": { "$value": "{color.neutral.900}" },
          "overlay": { "$value": "rgb(0 0 0 / 0.6)" }
        },
        "border": {
          "default": { "$value": "{color.neutral.900}" },
          "soft": { "$value": "{color.neutral.925}" },
          "strong": { "$value": "{color.neutral.800}" },
          "input": { "$value": "{color.neutral.600}" }
        },
        "action": {
          "secondary-bg": { "$value": "{color.neutral.925}" },
          "secondary-bg-hover": { "$value": "{color.neutral.900}" },
          "secondary-fg": { "$value": "{color.neutral.100}" }
        },
        "focus": {
          "ring": { "$value": "{color.brand.400}" }
        },
        "value": {
          "positive": { "$value": "{color.green.400}" },
          "negative": { "$value": "{color.red.400}" },
          "progress": { "$value": "{color.neutral.100}" },
          "progress-track": { "$value": "{color.neutral.900}" }
        },
        "status": {
          "success-fg": { "$value": "{color.green.400}" },
          "success-bg": { "$value": "{color.green.950}" },
          "warning-fg": { "$value": "{color.amber.400}" },
          "warning-bg": { "$value": "{color.amber.950}" },
          "warning-line": { "$value": "{color.amber.400}" },
          "danger-fg": { "$value": "{color.red.400}" },
          "danger-bg": { "$value": "{color.red.950}" },
          "info-fg": { "$value": "{color.brand.400}" },
          "info-bg": { "$value": "{color.brand.950}" }
        },
        "chart": {
          "primary": { "$value": "{color.brand.400}" },
          "positive": { "$value": "{color.green.400}" },
          "negative": { "$value": "{color.red.400}" },
          "secondary": { "$value": "{color.neutral.300}" },
          "tertiary": { "$value": "{color.brand.700}" },
          "grid": { "$value": "{color.neutral.900}" },
          "axis": { "$value": "{color.neutral.400}" }
        }
      }
    }
  },

  "$pairs": [
    { "fg": "color.text.default", "bg": "color.surface.default", "use": "text" },
    { "fg": "color.text.secondary", "bg": "color.surface.default", "use": "text" },
    { "fg": "color.text.muted", "bg": "color.surface.default", "use": "text" },
    { "fg": "color.text.default", "bg": "color.surface.sidebar", "use": "text" },
    { "fg": "color.text.secondary", "bg": "color.surface.sidebar", "use": "text" },
    { "fg": "color.text.muted", "bg": "color.surface.sidebar", "use": "text" },
    { "fg": "color.text.default", "bg": "color.surface.raised", "use": "text" },
    { "fg": "color.text.muted", "bg": "color.surface.raised", "use": "text" },
    { "fg": "color.text.default", "bg": "color.surface.hover", "use": "text" },
    { "fg": "color.text.muted", "bg": "color.surface.hover", "use": "text" },
    { "fg": "color.text.default", "bg": "color.surface.selected", "use": "text" },
    { "fg": "color.text.link", "bg": "color.surface.default", "use": "text" },
    { "fg": "color.text.link", "bg": "color.surface.raised", "use": "text" },
    { "fg": "color.action.fg", "bg": "color.action.bg", "use": "text" },
    { "fg": "color.action.fg", "bg": "color.action.bg-hover", "use": "text" },
    { "fg": "color.action.secondary-fg", "bg": "color.action.secondary-bg", "use": "text" },
    { "fg": "color.action.secondary-fg", "bg": "color.action.secondary-bg-hover", "use": "text" },
    { "fg": "color.action.danger-fg", "bg": "color.action.danger-bg", "use": "text" },
    { "fg": "color.value.positive", "bg": "color.surface.default", "use": "text" },
    { "fg": "color.value.negative", "bg": "color.surface.default", "use": "text" },
    { "fg": "color.value.positive", "bg": "color.surface.raised", "use": "text" },
    { "fg": "color.value.negative", "bg": "color.surface.raised", "use": "text" },
    { "fg": "color.value.pill-fg", "bg": "color.value.positive-bg", "use": "text" },
    { "fg": "color.value.pill-fg", "bg": "color.value.negative-bg", "use": "text" },
    { "fg": "color.value.progress", "bg": "color.value.progress-track", "use": "ui" },
    { "fg": "color.status.success-fg", "bg": "color.status.success-bg", "use": "text" },
    { "fg": "color.status.warning-fg", "bg": "color.status.warning-bg", "use": "text" },
    { "fg": "color.status.danger-fg", "bg": "color.status.danger-bg", "use": "text" },
    { "fg": "color.status.info-fg", "bg": "color.status.info-bg", "use": "text" },
    { "fg": "color.status.warning-line", "bg": "color.surface.default", "use": "ui" },
    { "fg": "color.border.input", "bg": "color.surface.raised", "use": "ui" },
    { "fg": "color.focus.ring", "bg": "color.surface.default", "use": "ui" },
    { "fg": "color.focus.ring", "bg": "color.surface.raised", "use": "ui" },
    { "fg": "color.focus.ring", "bg": "color.surface.sidebar", "use": "ui" },
    { "fg": "color.chart.primary", "bg": "color.surface.default", "use": "ui" },
    { "fg": "color.chart.positive", "bg": "color.surface.default", "use": "ui" },
    { "fg": "color.chart.negative", "bg": "color.surface.default", "use": "ui" },
    { "fg": "color.chart.secondary", "bg": "color.surface.default", "use": "ui" },
    { "fg": "color.chart.axis", "bg": "color.surface.default", "use": "text" }
  ]
